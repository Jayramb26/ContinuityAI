# Optional. If omitted, ContinuityAI uses transparent rule-based extraction.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./continuityai.db

# Enable signed demo sessions. Use a long random value in production.
AUTH_SECRET=replace-with-a-long-random-secret
DEMO_EMAIL=demo@continuityai.app
DEMO_PASSWORD=ContinuityDemo2026!
# Optional trusted integration adapter token
INTEGRATION_WEBHOOK_TOKEN=replace-with-another-random-secret
